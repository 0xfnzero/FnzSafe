{
  "name": "@fnzero/safe",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "install:ai-runtime": "npm ci --prefix ai-runtime --omit=dev",
    "prepare:ai-runtime": "npm run install:ai-runtime && node scripts/prepare-ai-runtime.cjs",
    "test:ai-runtime": "npm test --prefix ai-runtime",
    "test:ai-runtime-live": "npm run test:live --prefix ai-runtime",
    "test:unit": "node --test src/lib/appStorage.test.mjs src/lib/browserStorage.test.mjs src/lib/chainMetadata.test.mjs src/lib/multichain.test.mjs src/lib/defillamaStats.test.mjs src/lib/fomoSignals.test.mjs src/lib/hydratedStorage.test.mjs src/lib/requestIntent.test.mjs src/lib/researchAiProviders.test.mjs src/lib/settingsCenter.test.mjs src/lib/tokenMarketTable.test.mjs src/lib/twitterChainDetection.test.mjs src/lib/twitterKols.test.mjs src/lib/twitterSignals.test.mjs",
    "dev": "next dev -H 127.0.0.1 -p 3840",
    "predev:stack": "node scripts/kill-dev-processes.cjs && node scripts/ensure-out.cjs",
    "dev:stack": "node scripts/dev-stack.cjs",
    "stop": "node scripts/kill-dev-processes.cjs",
    "backend": "cargo run --release -p fnzero-safe-desktop-api",
    "prebuild": "node scripts/assert-no-next-dev.cjs && node scripts/check-sensitive-inputs.cjs && npm run prepare:ai-runtime",
    "build": "next build",
    "build:desktop-api": "cargo build --release -p fnzero-safe-desktop-api",
    "start": "next start",
    "test:dependency-compat": "node scripts/test-dependency-compat.cjs",
    "test:devnet-airdrop": "node scripts/test-devnet-airdrop.cjs",
    "test:program-deploy": "node scripts/test-program-deploy.cjs",
    "lint": "node scripts/check-sensitive-inputs.cjs && eslint",
    "tauri": "node scripts/run-tauri-cef.cjs",
    "predesktop:dev": "node scripts/kill-dev-processes.cjs && node scripts/refresh-desktop-icons.cjs && npm run prepare:ai-runtime",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:build": "npm run tauri -- build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.21",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "brace-expansion-upstream": "npm:brace-expansion@5.0.9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.0"
    }
  }
}
