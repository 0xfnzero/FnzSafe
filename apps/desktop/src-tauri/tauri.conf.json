{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FnzSafe",
  "version": "0.4.0",
  "identifier": "dev.sol-safekey.ui",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:3840/en/",
    "beforeDevCommand": "npm run dev:stack",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FnzSafe",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://127.0.0.1:3840 http://127.0.0.1:3841; connect-src 'self' http://127.0.0.1:3841 https: wss:; img-src 'self' asset: data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fnzsafe"]
      }
    }
  }
}
